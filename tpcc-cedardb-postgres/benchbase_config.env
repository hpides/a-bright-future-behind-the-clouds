# --- Shared DB credentials ---------------------------------------------
# Used by both the cedardb/postgres server containers and the matching
# benchbase-* client containers, so they only need to be set once.
DB_USER=admin
DB_PASSWORD=#Cidr27#
DB_NAME=benchbase

# --- Host port mappings --------------------------------------------------
# Change these if they conflict with something already running on your host.
CEDARDB_HOST_PORT=5432
POSTGRES_HOST_PORT=5433

# --- TPC-C tuning (benchbase-cedardb / benchbase-postgres) ---------------
DB_ISOLATION=TRANSACTION_REPEATABLE_READ
TPCC_TERMINALS=64
TPCC_DURATION_SEC=60
BENCHBASE_CREATE=true
BENCHBASE_LOAD=true
BENCHBASE_EXECUTE=true

# --- Pi 5 config -------------------------
POSTGRES_TUNING_CONF=./tuning/tuning-pi5.conf
TPCC_WAREHOUSES=10
CPU_SET_DB=0-1
CPU_SET_BENCHBASE=2-3
MEMORY_LIMIT_DB=8g
MEMORY_LIMIT_BENCHBASE=8g

# --- M4 Max config -----------------------
POSTGRES_TUNING_CONF=./tuning/tuning-m4-max.conf
TPCC_WAREHOUSES=50
CPU_SET_DB=0-6
CPU_SET_BENCHBASE=7-13
MEMORY_LIMIT_DB=24g
MEMORY_LIMIT_BENCHBASE=24g

# --- Zen 5 config ------------------------
POSTGRES_TUNING_CONF=./tuning/tuning-zen5.conf
TPCC_WAREHOUSES=100
CPU_SET_DB=0-95
CPU_SET_BENCHBASE=96-191
MEMORY_LIMIT_DB=128g
MEMORY_LIMIT_BENCHBASE=128g

# --- DuckDB TPC-H ---------------------------------------------------------
TPCH_SCALE_FACTOR=1
