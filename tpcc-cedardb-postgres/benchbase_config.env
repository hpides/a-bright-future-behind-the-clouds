# --- Shared DB credentials ---------------------------------------------
# Used by both the cedardb/postgres server containers and the matching
# benchbase-* client containers, so they only need to be set once.
DB_USER=admin
DB_PASSWORD=#Cidr27#
DB_NAME=benchbase

# --- Host port mappings --------------------------------------------------
# Change these if they conflict with something already running on your host.
CEDARDB_HOST_PORT=5432
POSTGRES_HOST_PORT=5433

# --- TPC-C tuning (benchbase-cedardb / benchbase-postgres) ---------------
DB_ISOLATION=TRANSACTION_REPEATABLE_READ
TPCC_WAREHOUSES=10
TPCC_TERMINALS=6
TPCC_DURATION_SEC=60
BENCHBASE_CREATE=true
BENCHBASE_LOAD=true
BENCHBASE_EXECUTE=true

# --- COMPUTE RESOURCES -------------------
CPU_SET_DB=0-5
CPU_SET_BENCHBASE=6-11
MEMORY_LIMIT_DB=8g
MEMORY_LIMIT_BENCHBASE=8g

# --- DuckDB TPC-H ---------------------------------------------------------
TPCH_SCALE_FACTOR=1
